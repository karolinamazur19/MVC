@model MvcLibrary.Models.Book

@{
    ViewData["Title"] = "Dodaj Książkę";
}

<div class="container mt-4">
    <h2 class="text-primary">Dodaj nową pozycję</h2>
    <hr />
    <div class="row">
        <div class="col-md-6 shadow-sm p-4 border rounded bg-light">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold"></label>
                    <input asp-for="Title" class="form-control" placeholder="Wpisz tytuł..." />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Author" class="form-label fw-bold"></label>
                    <input asp-for="Author" class="form-control" placeholder="Wpisz autora..." />
                    <span asp-validation-for="Author" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ReleaseYear" class="form-label fw-bold"></label>
                    <input asp-for="ReleaseYear" class="form-control" type="number" />
                    <span asp-validation-for="ReleaseYear" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <input type="submit" value="Zapisz do bazy" class="btn btn-primary w-100" />
                </div>
            </form>

            <div class="mt-3 text-center">
                <a asp-action="Index">Wróć do listy biblioteki</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}